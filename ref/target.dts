	fragment@56 {
		phandle = <0x12e>;
		target = <&tlmm>;

		__overlay__ {

			cam_sensor_wide_avdd_active: cam_sensor_wide_avdd_active {
				phandle = <0xfd>;

				mux {
					function = "gpio";
					pins = "gpio148";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio148";
				};
			};

			cam_sensor_wide_avdd_suspend: cam_sensor_wide_avdd_suspend {
				phandle = <0xfe>;

				mux {
					function = "gpio";
					pins = "gpio148";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio148";
				};
			};

			cam_sensor_wide_avdd1_active: cam_sensor_wide_avdd1_active {
				phandle = <0xff>;

				mux {
					function = "gpio";
					pins = "gpio116";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio116";
				};
			};

			cam_sensor_wide_avdd1_suspend: cam_sensor_wide_avdd1_suspend {
				phandle = <0x100>;

				mux {
					function = "gpio";
					pins = "gpio116";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio116";
				};
			};

			cam_sensor_wide_reset_active: cam_sensor_wide_reset_active {
				phandle = <0x113>;

				mux {
					function = "gpio";
					pins = "gpio106";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio106";
				};
			};

			cam_sensor_wide_reset_suspend: cam_sensor_wide_reset_suspend {
				phandle = <0x114>;

				mux {
					function = "gpio";
					pins = "gpio106";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio106";
				};
			};

			cam_sensor_ultra_mclk_active: cam_sensor_ultra_mclk_active {
				phandle = <0x125>;

				mux {
					function = "cam_mclk";
					pins = "gpio91";
				};

