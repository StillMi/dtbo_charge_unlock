				dod_para0 = "1050", "2900", "2850", "2750", "65535", "3000", "2950", "2850";
				dod_para1 = "413", "2900", "2850", "2750", "1050", "3000", "2950", "2850", "65535", "3050", "3000", "2900";
				dod_para2 = "159", "2900", "2900", "2800", "413", "3000", "3000", "2900", "1050", "3050", "3050", "2950", "65535", "3150", "3150", "3050";
				dod_para3 = "79", "3050", "3050", "2950", "159", "3130", "3130", "3030", "413", "3200", "3200", "3100", "1050", "3260", "3260", "3160", "65535", "3310", "3310", "3210";
