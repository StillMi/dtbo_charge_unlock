	fragment@5 {
		target = <&soc>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_vol_up_default>;

				vol_up {
					label = "volume_up";
					gpios = <&tlmm>, <0x65 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};
			};
		};
	};

	fragment@6 {
		target = <&eusb2_phy0>;

		__overlay__ {
			dummy-supply = <&pmih010x_eusb2_repeater>;
			usb-repeater = <&pmih010x_eusb2_repeater>;
		};
	};

	fragment@7 {
		target = <&battery_charger>;

		__overlay__ {
			qcom,thermal-mitigation-step = <0x7a120>;
			#cooling-cells = <0x02>;
			qcom,ship-mode-immediate;
			qcom,wireless-fw-name = "cps4061.bin";
		};
	};

	fragment@8 {
		target = <&wcd_usbss>;

		__overlay__ {
			interrupt-parent = <&spmi0_bus>;
			interrupts = <0x00 0xb6 0x01 0x03>;
			interrupt-names = "usb_wcd";
			nvmem-cells = <&usb_mode>;
			nvmem-cell-names = "usb_mode";
			mode-switch;

			port {

				wcd_usbss_mux: endpoint {
					remote-endpoint = <&ucsi_audio_mux>;
					phandle = <0x38>;
				};
			};
		};
	};

	fragment@9 {
		target = <&pcie>;

		__overlay__ {
			power-domains = <&gcc>, <0x01>;
			power-domain-names = "gdsc-phy-vdd";
		};
	};

	fragment@10 {
		target = <&ufsphy_mem>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v4-canoe";
			vdda-phy-supply = <&L4G>;
			vdda-phy-max-microamp = <0x3d16c>;
			vdda-phy-min-microvolt = <0xdea80>;
			vdda-pll-supply = <&L1D>;
			vdda-pll-max-microamp = <0x5168>;
			vdda-qref-supply = <&L3D>;
			vdda-qref-max-microamp = <0xa1108>;
			vdda-refgen-supply = <&L3I>;
			vdda-refgen-max-microamp = <0xd799c>;
			status = "ok";
		};
	};

	fragment@11 {
		target = <&ufshc_mem>;

		__overlay__ {
			vcc-supply = <&L17B>;
			vcc-max-microamp = <0x124f80>;
			vccq-supply = <&L4D>;
			vccq-max-microamp = <0x124f80>;
			qcom,vccq-proxy-vote-supply = <&L4D>;
			qcom,vccq-proxy-vote-max-microamp = <0x124f80>;
			qcom,vddp-ref-clk-supply = <&L1G>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			qcom,vccq-parent-supply = <&S7F>;
			qcom,vccq-parent-max-microamp = <0x7cc180>;
			reset-gpios = <&tlmm>, <0xd9 0x01>;
			resets = <&gcc>, <0x19>;
			reset-names = "rst";
			status = "ok";
		};
	};

	fragment@12 {
		target = <&sdhc_2>;

		__overlay__ {
			vdd-supply = <&L9B>;
			qcom,vdd-voltage-level = <0x2d0370 0x2d2a80>;
			qcom,vdd-current-level = <0x21 0xee868>;
			vdd-io-supply = <&L8B>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&sdc2_on>;
			pinctrl-1 = <&sdc2_off>;
			cd-gpios = <&tlmm>, <0x37 0x01>;
			resets = <&gcc>, <0x17>;
			reset-names = "core_reset";
			qcom,uses_level_shifter;
			qcom,external-fb-clk;
			status = "disabled";
		};
	};

	fragment@13 {
		target = <&usb0>;

		__overlay__ {
			usb-role-switch;

			port {

				usb_port0: endpoint {
					remote-endpoint = <&usb_port0_connector>;
					phandle = <0x37>;
				};
			};
		};
	};

	fragment@14 {
		target = <&ucsi>;

		__overlay__ {

			connector {
				compatible = "usb-c-connector";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						usb_port0_connector: endpoint {
							remote-endpoint = <&usb_port0>;
							phandle = <0x36>;
						};
					};

					port@1 {
						reg = <0x01>;

						ucsi_audio_mux: endpoint {
							remote-endpoint = <&wcd_usbss_mux>;
							phandle = <0x35>;
						};
					};
				};
			};
		};
	};

	fragment@15 {
		target = <&pmic_glink_debug>;

		__overlay__ {

			i2c@104 {
				reg = <0x104>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				qcom,bus-type = "i2c";

				smb1501@68 {
					compatible = "qcom,i2c-pmic";
					reg = <0x68>;
					qcom,can-sleep;
				};

				smb1501@69 {
					compatible = "qcom,i2c-pmic";
					reg = <0x69>;
					qcom,can-sleep;
				};

				cps4061@30 {
					compatible = "qcom,i2c-pmic";
					reg = <0x30>;
					qcom,can-sleep;
				};
			};
		};
	};

	fragment@16 {
		target = <&pmic_glink_adc>;

		__overlay__ {
			status = "ok";

			smb1501_1_iin {
				reg = <0x1046801>;
