	fragment@46 {
		target = <&soc>;

		__overlay__ {

			xiaomi_touch {
				compatible = "xiaomi-touch";
				status = "ok";
				touch,name = "xiaomi-touch";
			};

			touch_avdd_vreg: touch_avdd_vreg {
				compatible = "regulator-fixed";
				regulator-name = "touch_avdd_vreg";
				enable-active-high;
				gpio = <&tlmm>, <0x75 0x00>;
				phandle = <0x59>;
			};
		};
	};

	fragment@47 {
		target = <&L4I>;

		__overlay__ {
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			qcom,init-voltage = <0x1b7740>;
		};
	};

	fragment@48 {
		target = <&tlmm>;

		__overlay__ {

			syna_tcm_eint_init: syna_tcm_eint_init {
				phandle = <0x5a>;

				mux {
					pins = "gpio158";
					function = "gpio";
				};

				config {
					pins = "gpio158";
					bias-disable;
					input-enable;
				};
			};

			syna_tcm_rst_init: syna_tcm_rst_init {
				phandle = <0x5b>;

				mux {
					pins = "gpio66";
					function = "gpio";
				};

				config {
					pins = "gpio66";
					bias-disable;
					output-low;
				};
			};

			syna_tcm_eint_suspend: syna_tcm_eint_suspend {
				phandle = <0x5c>;

				mux {
					pins = "gpio158";
					function = "gpio";
				};

				config {
					pins = "gpio158";
					bias-pull-down;
				};
			};

			syna_tcm_rst_suspend: syna_tcm_rst_suspend {
				phandle = <0x5d>;

				mux {
					pins = "gpio66";
					function = "gpio";
				};

				config {
					pins = "gpio66";
					bias-pull-down;
					output-low;
				};
			};

			mi_ts_spi_miso_active: mi_ts_spi_miso_active {
				phandle = <0x54>;

				mux {
					pins = "gpio48";
					function = "qup4_se0_l0";
				};

				config {
					pins = "gpio48";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_mosi_active: mi_ts_spi_mosi_active {
				phandle = <0x53>;

				mux {
					pins = "gpio49";
					function = "qup4_se0_l1";
				};

				config {
					pins = "gpio49";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_clk_active: mi_ts_spi_clk_active {
				phandle = <0x55>;

				mux {
					pins = "gpio50";
					function = "qup4_se0_l2";
				};

				config {
					pins = "gpio50";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_cs_active: mi_ts_spi_cs_active {
				phandle = <0x56>;

				mux {
					pins = "gpio51";
					function = "qup4_se0_l3";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_cs_sleep: mi_ts_spi_cs_sleep {
				phandle = <0x58>;

				mux {
					pins = "gpio51";
					function = "gpio";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-pull-up;
				};
			};

			mi_ts_spi_sleep: mi_ts_spi_sleep {
				phandle = <0x57>;

				mux {
					pins = "gpio48", "gpio49", "gpio50";
					function = "gpio";
				};

				config {
					pins = "gpio48", "gpio49", "gpio50";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

	fragment@49 {
		target = <&qupv3_se19_spi>;

		__overlay__ {
			status = "ok";
			pinctrl-0 = <&mi_ts_spi_mosi_active>, <&mi_ts_spi_miso_active>, <&mi_ts_spi_clk_active>, <&mi_ts_spi_cs_active>;
			pinctrl-1 = <&mi_ts_spi_sleep>, <&mi_ts_spi_cs_sleep>;
			qcom,la-vm;
			qcom,rt;

			synaptics_tcm@0 {
				compatible = "synaptics,tcm-spi", "novatek,NVT-ts-spi";
				reg = <0x00>;
				spi-max-frequency = <0xe4e1c0>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x9e 0x2008>;
