					function = "cam_mclk";
					pins = "gpio91";
				};

				config {
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio91";
				};
			};

			cam_sensor_ultra_rst_active: cam_sensor_ultra_rst_active {
				phandle = <0x127>;
				power-source = <0x00>;
				output-high;
				drive-strength = <0x02>;
				pins = "gpio3";
			};

			cam_sensor_ultra_rst_suspend: cam_sensor_ultra_rst_suspend {
				phandle = <0x128>;
				output-low;
				drive-strength = <0x02>;
				pins = "gpio3";
			};

			cam_sensor_mclk4_active: cam_sensor_mclk4_active {
				phandle = <0x121>;

				mux {
					function = "cam_asc_mclk4";
					pins = "gpio93";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio93";
				};
			};

			cam_sensor_mclk4_suspend: cam_sensor_mclk4_suspend {
				phandle = <0x123>;

				mux {
					function = "cam_asc_mclk4";
					pins = "gpio93";
				};

				config {
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio93";
				};
			};

			cam_sensor_active_rst4: cam_sensor_active_rst4 {
				phandle = <0x122>;

				mux {
					function = "gpio";
					pins = "gpio7";
				};

				config {
					qcom,apps;
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio7";
				};
			};

			cam_sensor_suspend_rst4: cam_sensor_suspend_rst4 {
				phandle = <0x124>;

				mux {
					function = "gpio";
					pins = "gpio7";
				};

				config {
					qcom,remote;
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio7";
				};
			};

			pudding_qupv3_se8_i2c_pins: pudding_qupv3_se8_i2c_pins {
				phandle = <0x129>;

				pudding_qupv3_se8_i2c_sda_active: pudding_qupv3_se8_i2c_sda_active {
					phandle = <0x11a>;

					mux {
						function = "qup2_se0_l0";
						pins = "gpio0";
					};

					config {
						qcom,apps;
						bias-disable;
						drive-strength = <0x02>;
						pins = "gpio0";
					};
				};

				pudding_qupv3_se8_i2c_scl_active: pudding_qupv3_se8_i2c_scl_active {
					phandle = <0x11b>;

					mux {
						function = "qup2_se0_l1";
						pins = "gpio1";
					};

					config {
						qcom,apps;
						bias-disable;
						drive-strength = <0x02>;
						pins = "gpio1";
					};
				};

				pudding_qupv3_se8_i2c_sleep: pudding_qupv3_se8_i2c_sleep {
					phandle = <0x11c>;

					mux {
						function = "gpio";
						pins = "gpio0", "gpio1";
					};

					config {
						qcom,remote;
						drive-strength = <0x02>;
						pins = "gpio0", "gpio1";
					};
				};
			};

			cam_sensor_tele_mclk3_1p8_active: cam_sensor_tele_mclk3_1p8_active {
				phandle = <0x105>;

				mux {
					function = "cam_mclk";
					pins = "gpio92";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio92";
				};
			};

			cam_sensor_tele_mclk3_1p8_suspend: cam_sensor_tele_mclk3_1p8_suspend {
				phandle = <0x107>;

				mux {
					function = "cam_mclk";
					pins = "gpio92";
				};

				config {
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio92";
				};
			};

			cam_sensor_tele_active_drv_avdd: cam_sensor_tele_active_drv_avdd {
				phandle = <0x101>;

				mux {
					function = "gpio";
					pins = "gpio160";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio160";
				};
			};

			cam_sensor_tele_suspend_drv_avdd: cam_sensor_tele_suspend_drv_avdd {
				phandle = <0x102>;

				mux {
					function = "gpio";
					pins = "gpio160";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio160";
				};
			};

			cam_sensor_tele_active_avdd: cam_sensor_tele_active_avdd {
				phandle = <0x103>;

				mux {
					function = "gpio";
					pins = "gpio113";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio113";
				};
			};

			cam_sensor_tele_suspend_avdd: cam_sensor_tele_suspend_avdd {
				phandle = <0x104>;

				mux {
					function = "gpio";
					pins = "gpio113";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio113";
				};
			};

			cam_sensor_tele_1p8_rst1_active: cam_sensor_tele_1p8_rst1_active {
				phandle = <0x106>;

				mux {
					function = "gpio";
					pins = "gpio105";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio105";
				};
			};

			cam_sensor_tele_1p8_rst1_suspend: cam_sensor_tele_1p8_rst1_suspend {
				phandle = <0x108>;

				mux {
					function = "gpio";
					pins = "gpio105";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio105";
				};
			};

			pudding_cci_i2c_scl0_active: pudding_cci_i2c_scl0_active {
				phandle = <0x109>;

				mux {
					function = "cci_i2c_scl0";
