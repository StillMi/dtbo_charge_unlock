	fragment@41 {
		target = <&tlmm>;

		__overlay__ {

			charger_cp_nlpm_default: charger_cp_nlpm_default {
				phandle = <0x4e>;

				mux {
					pins = "gpio114";
					function = "gpio";
				};

				config {
					pins = "gpio114";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			charger_cp_int_default: charger_cp_int_default {
				phandle = <0x4f>;

				mux {
					pins = "gpio68";
					function = "gpio";
				};

				config {
					pins = "gpio68";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			wireless_rx_int_default: wireless_rx_int_default {
				phandle = <0x50>;

				mux {
					pins = "gpio69";
					function = "gpio";
				};

				config {
					pins = "gpio69";
					drive-strength = <0x02>;
					bias-pull-up;
					input-enable;
					qcom,apps;
				};
			};

			hall_s_int_default: hall_s_int_default {
				phandle = <0x51>;

				mux {
					pins = "gpio79";
					function = "gpio";
				};

				config {
					pins = "gpio79";
					drive-strength = <0x02>;
					bias-disable;
					input-enable;
					qcom,apps;
				};
			};

			hall_n_int_default: hall_n_int_default {
				phandle = <0x52>;

				mux {
					pins = "gpio78";
					function = "gpio";
				};

				config {
					pins = "gpio78";
					drive-strength = <0x02>;
					bias-disable;
					input-enable;
					qcom,apps;
				};
			};
		};
	};

	fragment@42 {
		target = <&qupv3_se5_i2c>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			bq27z561_standlone@55 {
				compatible = "ti,bq27z561_master";
				ic_role = <0x00>;
				reg = <0x55>;
				unseal_key = <0x3b30b98a>;
				bq,charge-full-design = <0x1b58>;
				soh_th = <0x5c>;
				cycle_th = <0x190>;
				cycle_step = <0x32>;
				resistance-id = <0x186a0>;
				support_batt_manager_4p0;
				base_termv = <0xb22>;
				base_termv_gl = <0xbb8>;
				delta_soh_compesation = <0x00 0x00 0x32 0x00 0x64 0x02 0x96 0x04 0xc8 0x06 0xfa 0x08 0x12c 0x0a 0x15e 0x0c 0x190 0x0e 0x1c2 0x10 0x1f4 0x12 0x226 0x13>;
				delta_soh_compesation_gl = <0x00 0x00 0x32 0x01 0x64 0x03 0x96 0x06 0xc8 0x08 0xfa 0x0a 0x12c 0x0d 0x15e 0x0f 0x190 0x12 0x1c2 0x12 0x1f4 0x12>;
				status = "ok";
			};

			sc8585_master@6e {
				compatible = "sc8585_master";
				status = "ok";
				ic_role = <0x00>;
				reg = <0x6e>;
				cp-int = <&tlmm>, <0x44 0x00>;
				cp-nlpm-gpio = <&tlmm>, <0x72 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&charger_cp_nlpm_default>, <&charger_cp_int_default>;
				bat-ovp-threshold = <0x125c>;
				bat-ovp-alarm-threshold = <0x122a>;
				bus-ovp-threshold = <0x5208 0x2ee0 0x1770>;
				usb-ovp-threshold = <0x5208 0x36b0 0x1d4c>;
				bus-ocp-threshold = <0x1388 0x157c 0x1388>;
				wpc-ovp-threshold = <0x5208>;
				out-ovp-threshold = <0x1388>;
				pmid2-uvp-threshold = <0x15e 0x15e 0x64>;
				pmid2-ovp-threshold = <0x258>;
			};

			hl7603@77 {
				compatible = "hl7603";
				reg = <0x77>;
				vout_threshold = <0xd48>;
			};
		};
	};

	fragment@43 {
		target = <&qupv3_se22_i2c>;

		__overlay__ {
			status = "ok";
