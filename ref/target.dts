	fragment@36 {
		target = <&tlmm>;

		__overlay__ {

			nfc {

				nfc_int_active: nfc_int_active {
					phandle = <0x46>;

					mux {
						pins = "gpio75";
						function = "gpio";
					};

					config {
						pins = "gpio75";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				nfc_int_suspend: nfc_int_suspend {
					phandle = <0x48>;

					mux {
						pins = "gpio75";
						function = "gpio";
					};

					config {
						pins = "gpio75";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				nfc_enable_active: nfc_enable_active {
					phandle = <0x47>;

					mux {
						pins = "gpio34", "gpio35";
						function = "gpio";
					};

					config {
						pins = "gpio34", "gpio35";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				nfc_enable_suspend: nfc_enable_suspend {
					phandle = <0x49>;

					mux {
						pins = "gpio34", "gpio35";
						function = "gpio";
					};

					config {
						pins = "gpio34", "gpio35";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
		};
