				vol_up {
					label = "volume_up";
					gpios = <&tlmm>, <0x65 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					gpio-key,wakeup;
					debounce-interval = <0x20>;
					linux,can-disable;
				};
			};
		};
