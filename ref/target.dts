				qcom,vdd-wlan-dig-config = <0xd9c60 0xf4240 0x00 0x00 0x01>;
				vdd-wlan-dig-supply = <&S2J>;
				qcom,vdd-wlan-cx-config = <0xd9c60 0xf4240 0x00 0x00 0x01>;
				vdd-wlan-cx-supply = <&S1J>;
				qcom,vdd-wlan-io12-config = <0x124f80 0x124f80 0x7530 0x00 0x01>;
				vdd-wlan-io12-supply = <&L3G>;
				qcom,vdd-wlan-aon-config = <0x1b7740 0x1b7740 0x7530 0x00 0x01>;
				vdd-wlan-aon-supply = <&L2G>;
				platform-name-required;
				msix-match-addr = <0x3000>;
				qcom,qmp = <&aoss_qmp>;
				qcom,same-dt-multi-dev;
				use-pm-domain;
				qcom,wlan-cbc-enabled;
				cnss-enable-self-recovery;
				qcom,wlan-ramdump-dynamic = <0x600000>;
				qcom,wlan-rc-num = <0x00>;
				qcom,wlan;
				pinctrl-4 = <&cnss_host_sol_default>;
				pinctrl-3 = <&cnss_wlan_sw_ctrl_wl_cx>;
				pinctrl-2 = <&cnss_wlan_sw_ctrl>;
				pinctrl-1 = <&cnss_wlan_en_sleep>;
