	fragment@3 {
		target = <&soc>;

		__overlay__ {

			power-zones {

				soc {

					cpu-m {
						power-channels = <&pmk8850_qpt>, <0x6b6>;
					};

					cpu-m-spare {
						power-channels = <&pmk8850_qpt>, <0x8b0>;
					};

					cpu-l {
						power-channels = <&pmk8850_qpt>, <0x89e>;
					};

					cpu-l-spare {
						power-channels = <&pmk8850_qpt>, <0x8b3>;
					};

					gpu {
						power-channels = <&pmk8850_qpt>, <0x59b>;
					};

					gpu-spare {
						power-channels = <&pmk8850_qpt>, <0x5b6>;
					};

					nsp {
						power-channels = <&pmk8850_qpt>, <0x39e>;
					};

					nsp-spare {
						power-channels = <&pmk8850_qpt>, <0x3a4>;
					};

					debug-0 {
						power-channels = <&pmk8850_qpt>, <0x5b3>;
					};

					debug-1 {
						power-channels = <&pmk8850_qpt>, <0x8b6>;
					};

					debug-2 {
						power-channels = <&pmk8850_qpt>, <0x6a7>;
					};

					debug-3 {
						power-channels = <&pmk8850_qpt>, <0x39b>;
					};

					debug-4 {
						power-channels = <&pmk8850_qpt>, <0x3ad>;
					};

					debug-5 {
						power-channels = <&pmk8850_qpt>, <0x6b0>;
					};

					debug-6 {
						power-channels = <&pmk8850_qpt>, <0x9a4>;
					};

					debug-7 {
						power-channels = <&pmk8850_qpt>, <0x6ad>;
					};

					debug-8 {
						power-channels = <&pmk8850_qpt>, <0x5ad>;
					};

					debug-9 {
						power-channels = <&pmk8850_qpt>, <0x99e>;
					};

					debug-10 {
						power-channels = <&pmk8850_qpt>, <0x9a1>;
					};

					debug-11 {
						power-channels = <&pmk8850_qpt>, <0x3b6>;
					};

					debug-12 {
						power-channels = <&pmk8850_qpt>, <0x8ad>;
					};
				};
			};
		};
	};

	fragment@4 {
		target = <&thermal_zones>;

		__overlay__ {

			pmih010x-ibat-lvl0 {
				thermal-sensors = <&pmih010x_bcl>, <0x00>;

				trips {

					ibat_lvl0: ibat-lvl0 {
						temperature = <0x34bc>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x9f>;
					};
				};
			};

			pmih010x-ibat-lvl1 {
				thermal-sensors = <&pmih010x_bcl>, <0x01>;

				trips {

					ibat_lvl1: ibat-lvl1 {
						temperature = <0x3a98>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xa0>;
					};
				};
			};

			pmih010x-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmih010x_bcl>, <0x05>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl0: b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x1c>;
					};
				};

				cooling-maps {

					lbat_lvl0 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&modem_bcl_mtpl_dsc>, <0x00 0x01>, <&modem_bcl>, <0x00 0x01>, <&msm_gpu>, <0x00 0x01>;
					};
				};
			};

			pmih010x-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmih010x_bcl>, <0x06>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl1: b-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x1d>;
					};
				};

				cooling-maps {

					lbat_lvl1 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&modem_bcl_mtpl_dsc>, <0x00 0x02>, <&modem_bcl>, <0x00 0x02>, <&msm_gpu>, <0x00 0x02>;
					};
				};
			};

			pmih010x-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmih010x_bcl>, <0x07>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl2: b-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x1e>;
					};
				};

				cooling-maps {

					lbat_gpu2 {
						trip = <&b_bcl_lvl2>;
						cooling-device = <&msm_gpu>, <0x00 0x03>;
					};
				};
			};

			pmh0101-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmh0101_bcl>, <0x05>;

				trips {

					bcl_lvl0: bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x20>;
					};
				};

				cooling-maps {

					vph_lvl0 {
						trip = <&bcl_lvl0>;
						cooling-device = <&modem_bcl>, <0x00 0x01>, <&msm_gpu>, <0x00 0x01>;
					};
				};
			};

			pmh0101-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmh0101_bcl>, <0x06>;

				trips {

					bcl_lvl1: bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x21>;
					};
				};

				cooling-maps {

					vph_lvl1 {
						trip = <&bcl_lvl1>;
						cooling-device = <&modem_bcl>, <0x00 0x02>, <&msm_gpu>, <0x00 0x02>;
					};
				};
			};

			pmh0101-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmh0101_bcl>, <0x07>;

				trips {

					bcl_lvl2: bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x22>;
					};
				};

				cooling-maps {

					vph_gpu2 {
						trip = <&bcl_lvl2>;
						cooling-device = <&msm_gpu>, <0x00 0x03>;
					};
				};
			};

			pmih010x_temp_alarm: pmih010x_tz {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmih010x_tz>;
				phandle = <0xa1>;

				trips {

					pmih010x_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xa2>;
					};

					pmih010x_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0xa3>;
					};

					pmih010x_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xa4>;
					};
				};
			};

			pmh0101_temp_alarm: pmh0101_tz {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmh0101_tz>;
				phandle = <0xa5>;

				trips {

					pmh0101_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xa6>;
					};

					pmh0101_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0xa7>;
					};

					pmh0101_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xa8>;
					};
				};
			};

			pmh0110_d_temp_alarm: pmh0110_d_tz {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmh0110_d_tz>;
				phandle = <0xa9>;

				trips {

					pmh0110_d_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x26>;
					};

					pmh0110_d_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0xaa>;
					};

					pmh0110_d_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xab>;
					};
				};

				cooling-maps {

					d_hvx {
						trip = <&pmh0110_d_trip0>;
						cooling-device = <&cdsp_sw_hvx>, <0x05 0xffffffff>, <&modem_lte_dsc>, <0xff 0xff>, <&modem_nr_dsc>, <0xff 0xff>;
					};
				};
			};

			pmh0110_f_temp_alarm: pmh0110_f_tz {
				polling-delay-passive = <0x64>;
				thermal-sensors = <&pmh0110_f_tz>;
				phandle = <0xac>;

