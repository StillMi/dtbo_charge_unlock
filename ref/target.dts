				qcom,bus-bw-cfg = <0x00 0x00 0x8ca 0x4b320 0x1d4c 0x4b320 0x7530 0x4b320 0x186a0 0x4b320 0x2ab98 0x30fb10 0x4c4b4 0x30fb10 0x8f6ec 0x626b50 0x1d4c 0x189110 0x00 0x00 0x8ca 0x216600 0x1d4c 0x216600 0x7530 0x216600 0x186a0 0x216600 0x2ab98 0x5eec00 0x4c4b4 0x7faf80 0x8f6ec 0xc35000 0x1d4c 0x216600>;
