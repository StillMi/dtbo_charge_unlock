	fragment@25 {
		target = <&L14B>;

		__overlay__ {
			regulator-min-microvolt = <0x2dc6c0>;
			regulator-max-microvolt = <0x30d400>;
			qcom,init-voltage = <0x2dc6c0>;
			qcom,proxy-consumer-enable;
		};
	};

	fragment@26 {
		target = <&qupv3_se0_spi>;

		__overlay__ {
			status = "ok";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&qupv3_se0_spi_mosi_active>, <&ls_gpio_active>;
			pinctrl-1 = <&qupv3_se0_spi_sleep>, <&ls_gpio_sleep>;

			ir-spi@0 {
				compatible = "ir-spi";
				reg = <0x00>;
				spi-max-frequency = <0x124f800>;
				status = "ok";
			};
		};
	};

	fragment@27 {
		target = <&tlmm>;

		__overlay__ {

			fingerprint_irq_default: fingerprint_irq_default {
				phandle = <0x39>;

				mux {
					pins = "gpio99";
					function = "gpio";
				};

				config {
					pins = "gpio99";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};

			qupv3_se0_spi_mosi_active: qupv3_se0_spi_mosi_active {
				phandle = <0x3c>;

				mux {
					pins = "gpio83";
					function = "qup1_se0_l1";
				};

				config {
					pins = "gpio83";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			qupv3_se0_spi_sleep: qupv3_se0_spi_sleep {
				phandle = <0x3e>;

				mux {
					pins = "gpio83";
					function = "gpio";
				};

				config {
					pins = "gpio83";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			ls_gpio_active: ls_gpio_active {
				phandle = <0x3d>;

				mux {
					pins = "gpio159";
					function = "gpio";
				};

				config {
					pins = "gpio159";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};

			ls_gpio_sleep: ls_gpio_sleep {
				phandle = <0x3f>;

				mux {
					pins = "gpio159";
					function = "gpio";
				};

				config {
					pins = "gpio159";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};
		};
	};

	fragment@28 {
		target = <&usb0>;

		__overlay__ {
			qcom,wcd_usbss = <&wcd_usbss>;
			wcd_equ = <0xe0>;
