	fragment@231 {
		phandle = <0x34b>;
		target = <&soc>;

		__overlay__ {

			display_panel_vddd_p3: display_panel_vddd_p3 {
				phandle = <0x20d>;
				regulator-boot-on;
				enable-active-high;
				gpio = <&tlmm>, <0x5a 0x00>;
				regulator-max-microvolt = <0x102ca0>;
				regulator-min-microvolt = <0x102ca0>;
				regulator-name = "display_panel_vddd_p3";
				compatible = "regulator-fixed";
			};

			dsi_panel_pwr_supply_p3: dsi_panel_pwr_supply_p3 {
				phandle = <0x21c>;

				qcom,panel-supply-entry@0 {
					qcom,supply-post-off-sleep = <0x00>;
					qcom,supply-post-on-sleep = <0x00>;
					qcom,supply-disable-load = <0x00>;
					qcom,supply-enable-load = <0x493e0>;
					qcom,supply-max-voltage = <0x1b7740>;
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-name = "vddio";
					reg = <0x00>;
				};

				qcom,panel-supply-entry@1 {
					qcom,supply-post-off-sleep = <0x03>;
					qcom,supply-post-on-sleep = <0x01>;
					qcom,supply-disable-load = <0x00>;
					qcom,supply-enable-load = <0x493e0>;
					qcom,supply-max-voltage = <0x102ca0>;
					qcom,supply-min-voltage = <0x102ca0>;
					qcom,supply-name = "vddd";
					reg = <0x01>;
				};

				qcom,panel-supply-entry@2 {
					qcom,supply-post-off-sleep = <0x03>;
					qcom,supply-post-on-sleep = <0x08>;
					qcom,supply-disable-load = <0x00>;
					qcom,supply-enable-load = <0x493e0>;
					qcom,supply-max-voltage = <0x2dc6c0>;
					qcom,supply-min-voltage = <0x2dc6c0>;
					qcom,supply-name = "vci";
					reg = <0x02>;
				};
			};

			dsi_panel_pwr_supply_p3_b: dsi_panel_pwr_supply_p3_b {
				phandle = <0x21d>;

				qcom,panel-supply-entry@0 {
					qcom,supply-post-off-sleep = <0x00>;
					qcom,supply-post-on-sleep = <0x00>;
					qcom,supply-disable-load = <0x00>;
					qcom,supply-enable-load = <0x493e0>;
					qcom,supply-max-voltage = <0x1b7740>;
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-name = "vddio";
					reg = <0x00>;
				};

				qcom,panel-supply-entry@1 {
					qcom,supply-post-off-sleep = <0x03>;
					qcom,supply-post-on-sleep = <0x08>;
					qcom,supply-disable-load = <0x00>;
					qcom,supply-enable-load = <0x493e0>;
					qcom,supply-max-voltage = <0x325aa0>;
					qcom,supply-min-voltage = <0x325aa0>;
					qcom,supply-name = "vci";
					reg = <0x01>;
				};
			};

			dsi_panel_pwr_post_supply_p3_b: dsi_panel_pwr_post_supply_p3_b {
				phandle = <0x21e>;

				qcom,panel-supply-entry@0 {
					qcom,supply-post-off-sleep = <0x03>;
