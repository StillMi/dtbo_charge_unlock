				#address-cells = <0x02>;
				compatible = "qcom,cnss-direct-link";

				direct_link_iommu_region_partition: direct_link_iommu_region_partition {
					phandle = <0x356>;
					iommu-addresses = <&wlan_direct_link>, <0x00 0x00 0x00 0x18000000>, <&wlan_direct_link>, <0x00 0xb0000000 0x00 0x50000000>;
				};
			};

			wlan_vendor_wonder: qcom,cnss-vendor-wlan-wonder {
				phandle = <0x35c>;
				status = "okay";
				compatible = "qcom,cnss-vendor-wlan-wonder";
			};
		};
	};

