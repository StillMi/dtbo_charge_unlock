	fragment@18 {
		target = <&soc>;

		__overlay__ {

			xiaomi_fingerprint {
				compatible = "xiaomi,xiaomi-fp";
				xiaomi,gpio_irq = <&tlmm>, <0x63 0x00>;
				xiaomi,gpio_ipc = <&tlmm>, <0x63 0x00>;
				xiaomi,vendor_names = "P3_n2_132_431";
				iintr2-pin-enable;
				intr2-side-config = "TIC";
				intr2-default-electrical = <0x01 0x01>;
				intr1-trigger-high;
				fp_3v3_vreg-supply = <&L9B>;
				fp_1v8_vreg-supply = <&L10B>;
				netlink-event = <0x19>;
				sensor-loc = <0x1e0 0x772 0x2cf 0x875>;
				pinctrl-names = "irq_default";
				pinctrl-0 = <&fingerprint_irq_default>;
				status = "ok";
			};
		};
