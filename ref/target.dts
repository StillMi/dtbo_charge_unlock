	fragment@20 {
		target = <&reserved_memory>;

		__overlay__ {

			oem_vm_shm: shm@fc200000 {
				compatible = "shared-dma-pool";
				reusable;
				guarantee;
				alignment = <0x00 0x400000>;
				reg = <0x00 0xfc200000 0x00 0x400000>;
				gunyah-label = <0x03>;
				phandle = <0x3a>;
			};
		};
	};

	fragment@21 {
		target = <&soc>;

		__overlay__ {

			mitee: mitee {
