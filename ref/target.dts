	fragment@71 {
		phandle = <0x135>;
		target = <&soc>;

		__overlay__ {

			led_flash_rear_wide: qcom,camera-flash1 {
				phandle = <0x111>;
				status = "ok";
				leds = <&pmh0101_flash_led0>;
				compatible = "qcom,camera-flash";
				cell-index = <0x01>;
			};

			led_flash_rear_ultra: qcom,camera-flash2 {
				phandle = <0x11d>;
				status = "ok";
				leds = <&pmh0101_flash_led0>;
				compatible = "qcom,camera-flash";
				cell-index = <0x02>;
			};

			led_flash_rear_tele: qcom,camera-flash3 {
				phandle = <0x116>;
				status = "ok";
				leds = <&pmh0101_flash_led0>;
				compatible = "qcom,camera-flash";
				cell-index = <0x03>;
			};

			camera_wide_avdd_ldo: gpio-regulator@0 {
				phandle = <0x10d>;
				pinctrl-1 = <&cam_sensor_wide_avdd_suspend>;
				pinctrl-0 = <&cam_sensor_wide_avdd_active>;
				pinctrl-names = "wide_avdd_active", "wide_avdd_suspend";
				gpio = <&tlmm>, <0x94 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0x64>;
				regulator-max-microvolt = <0x2ab980>;
				regulator-min-microvolt = <0x2ab980>;
				regulator-name = "camera_wide_avdd_ldo";
				reg = <0x01 0x00>;
				compatible = "regulator-fixed";
			};

			camera_wide_avdd1_ldo: gpio-regulator@1 {
				phandle = <0x10e>;
				pinctrl-1 = <&cam_sensor_wide_avdd1_suspend>;
				pinctrl-0 = <&cam_sensor_wide_avdd1_active>;
				pinctrl-names = "wide_avdd1_active", "wide_avdd1_suspend";
				gpio = <&tlmm>, <0x74 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0x64>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-min-microvolt = <0x1b7740>;
				regulator-name = "camera_wide_avdd1_ldo";
				reg = <0x02 0x00>;
				compatible = "regulator-fixed";
			};

			camera_tele_drv_avdd_ldo: gpio-regulator@2 {
				phandle = <0x12a>;
				pinctrl-0 = <&cam_sensor_tele_active_drv_avdd>, <&cam_sensor_tele_suspend_drv_avdd>;
				pinctrl-names = "tele_drv_avdd_active", "tele_drv_avdd_suspend";
				gpio = <&tlmm>, <0xa0 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0x64>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-min-microvolt = <0x325aa0>;
				regulator-name = "camera_tele_drv_avdd_ldo";
				reg = <0x03 0x00>;
				compatible = "regulator-fixed";
			};

			camera_tele_avdd_ldo: gpio-regulator@3 {
				phandle = <0x115>;
				pinctrl-0 = <&cam_sensor_tele_active_avdd>, <&cam_sensor_tele_suspend_avdd>;
				pinctrl-names = "tele_avdd_active", "tele_avdd_suspend";
				gpio = <&tlmm>, <0x71 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0x64>;
				regulator-max-microvolt = <0x2191c0>;
				regulator-min-microvolt = <0x2191c0>;
				regulator-name = "camera_tele_avdd_ldo";
				reg = <0x04 0x00>;
				compatible = "regulator-fixed";
			};

			camera_iovdd_ldo: regulator-1v2 {
				phandle = <0x10f>;
				regulator-supply = <&L5M>;
				regulator-enable-ramp-delay = <0x64>;
				regulator-max-microvolt = <0x124f80>;
				regulator-min-microvolt = <0x124f80>;
				regulator-name = "camera_iovdd_ldo";
				compatible = "regulator-fixed";
			};

			qcom,cam-res-mgr {
				status = "ok";
				pinctrl-1 = <&cam_sensor_tele_mclk3_1p8_suspend>, <&cam_sensor_tele_1p8_rst1_suspend>;
				pinctrl-0 = <&cam_sensor_tele_mclk3_1p8_active>, <&cam_sensor_tele_1p8_rst1_active>;
				pinctrl-names = "cam_tele_active", "cam_tele_suspend";
				shared-pctrl-gpio-names = "cam_tele", "cam_tele";
				gpios-shared-pinctrl = <0x25c 0x269>;
				compatible = "qcom,cam-res-mgr";
			};
		};
	};

	fragment@73 {
		phandle = <0x136>;
		target = <&cam_cci0>;

		__overlay__ {
			pinctrl-2 = <&pudding_cci_i2c_scl1_active>, <&pudding_cci_i2c_sda1_active>;
			pinctrl-0 = <&pudding_cci_i2c_scl0_active>, <&pudding_cci_i2c_sda0_active>;

			actuator_wide: qcom,actuator0 {
				phandle = <0x110>;
				status = "ok";
				cci-master = <0x01>;
				rgltr-load-current = <0x249f0 0x249f0 0x249f0 0xc6fd4 0x249f0 0x249f0 0x1e8480>;
				rgltr-max-voltage = <0x2ab980 0x1b7740 0x1b7740 0x10f7c0 0x326a40 0x124f80 0x324b00>;
				rgltr-min-voltage = <0x2ab980 0x1b7740 0x124f80 0x10f7c0 0x326a40 0x124f80 0x294280>;
				rgltr-cntrl-support;
				regulator-names = "cam_vana", "cam_v_custom1", "cam_vio", "cam_vdig", "cam_vaf", "cam_v_custom3", "cam_bob2";
				cam_bob2-supply = <&BOB2>;
				cam_v_custom3-supply = <&camera_iovdd_ldo>;
				cam_vaf-supply = <&L2B>;
				cam_vdig-supply = <&L1F>;
				cam_vio-supply = <&L5M>;
				cam_v_custom1-supply = <&camera_wide_avdd1_ldo>;
				cam_vana-supply = <&camera_wide_avdd_ldo>;
				compatible = "qcom,actuator";
				cell-index = <0x00>;
			};

			qcom,cam-sensor0 {
				status = "ok";
				clock-rates = <0x124f800>;
				clock-cntl-level = "nominal";
				clock-names = "cam_clk";
				clocks = <&cambistmclkcc>, <0x0c>;
				cci-master = <0x01>;
				gpio-req-tbl-label = "CAMIF_MCLK5", "CAMW_RESET";
				gpio-req-tbl-flags = <0x01 0x00>;
				gpio-req-tbl-num = <0x00 0x01>;
				gpio-reset = <0x01>;
				gpios = <&tlmm>, <0x5e 0x00>, <&tlmm>, <0x6a 0x00>;
				pinctrl-1 = <&cam_sensor_mclk5_suspend>, <&cam_sensor_wide_reset_suspend>;
