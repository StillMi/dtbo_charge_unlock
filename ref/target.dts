/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. Pudding based on SM8850";
	compatible = "qcom,canoe-mtp", "qcom,canoe", "qcom,canoep-mtp", "qcom,canoep", "qcom,mtp";
	qcom,msm-id = <0x295 0x20000 0x294 0x10000 0x294 0x20000 0x1000294 0x10000 0x295 0x10000 0x1000295 0x10000 0x1000294 0x20000 0x1000295 0x20000>;
	qcom,board-id = <0x08 0x00>;
	xiaomi,miboard-id = <0x02 0x00>;

	fragment@0 {
		target = <&spmi0_bus>;

		__overlay__ {

			pmk8850: pmk8850@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x5e>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmk8850";
				};

				pmk8850_sdam_1: sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x5f>;

					ocp_log: ocp-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x18>;
					};
				};

				pmk8850_sdam_2: sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x60>;

					restart_reason: restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x15>;
					};

					bob1_off_mode_enable: bob1-off-mode-enable@50 {
						reg = <0x50 0x01>;
						phandle = <0x61>;
					};

					xo_calib_data: xo_calib-data@59 {
						reg = <0x59 0x01>;
						phandle = <0x62>;
					};

					alarm_log: alarm-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x19>;
					};

					fmd_set: fmd-set@9a {
						reg = <0x9a 0x01>;
						phandle = <0x63>;
					};

					fmd_cont_after_pon: fmd_cont_after_pon@9c {
						reg = <0x9c 0x01>;
						phandle = <0x64>;
					};

					fmd_chg_pon: fmd-chg-pon@9f {
						reg = <0x9f 0x01>;
						phandle = <0x65>;
					};

					fmd_cnt2_stop: fmd-cnt2-stop@a2 {
						reg = <0xa2 0x01>;
						phandle = <0x66>;
					};
				};

				pmk8850_sdam_5: sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x16>;
				};

				pmk8850_sdam_6: sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					phandle = <0x17>;
				};

				pmk8850_sdam_21: sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x0c>;
				};

				pmk8850_sdam_22: sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x0d>;
				};

				pmk8850_sdam_43: sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x67>;

					ibb_spur_sqm_timer: sqm-timer@b8 {
						reg = <0xb8 0x02>;
						phandle = <0x11>;
					};
				};

				pmk8850_sdam_46: sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x14>;
				};

				pmk8850_sdam_59: ecm_sdam_0: sdam@aa00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xaa00>;
					phandle = <0x0e>;
				};

				pmk8850_sdam_60: ecm_sdam_1: sdam@ab00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xab00>;
					phandle = <0x0f>;
				};

				pmk8850_sdam_61: ecm_sdam_2: sdam@ac00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xac00>;
					phandle = <0x10>;
				};

				pon_hlos@1300 {
					compatible = "qcom,pmk8350-pon";
					reg = <0x1300 0x800>;
					reg-names = "hlos", "pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};

					pwrkey-bark {
						compatible = "qcom,pmk8350-pwrkey-bark";
						interrupts = <0x00 0x13 0x00 0x03>;
						linux,code = <0x74>;
					};

					pwrkey-resin-bark {
						compatible = "qcom,pmk8350-pwrkey-resin-bark";
						interrupts = <0x00 0x13 0x02 0x03>;
						linux,code = <0x74>;
					};
				};

				pmk8850_sdam_49: sdam@a000 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa000>;
					phandle = <0x05>;
				};

				pmk8850_sdam_50: sdam@a100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa100>;
					phandle = <0x06>;
				};

				pmk8850_sdam_51: sdam@a200 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa200>;
					phandle = <0x07>;
				};

				pmk8850_sdam_71: sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					phandle = <0x68>;

					usb_mode: usb-mode@50 {
						reg = <0x50 0x01>;
						phandle = <0x34>;
					};
				};

				pmk8850_sdam_72: sdam@b700 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb700>;
					phandle = <0x08>;
				};

				pmk8850_gpios: pinctrl@b800 {
					compatible = "qcom,pmk8850-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <&alt_sleep_clk_default>;
					pinctrl-names = "default";
					phandle = <0x69>;

					alt_sleep_clk_default: alt-sleep-clk-default-state {
						pins = "gpio3";
						function = "func1";
						input-disable;
						output-enable;
						power-source = <0x00>;
						phandle = <0x01>;
					};

					lcd_bl_pwm_default: lcd-bl-pwm-default-state {
						pins = "gpio5";
						function = "func3";
						input-disable;
						output-enable;
						power-source = <0x00>;
						phandle = <0x6a>;
					};

					xoagg_therm_default: xoagg-therm-default-state {
						pins = "gpio7";
						function = "normal";
						bias-high-impedance;
						phandle = <0x02>;
					};
				};

				pmk8850_rtc: rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0x6b>;
				};

				pmk8850-pwm {
					compatible = "qcom,pmk8850-pwm", "qcom,pmk8550-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
				};

				pmk8850_vadc: vadc@9000 {
					compatible = "qcom,spmi-adc5-gen4";
					reg = <0x9000 0x9100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					interrupt-names = "adc-sdam0", "adc-sdam1";
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-0 = <&xoagg_therm_default>, <&pa_therm2_default>, <&qtm_therm_default>;
					pinctrl-names = "default";
					phandle = <0x09>;

					pmk8850_offset_ref {
						reg = <0x00>;
						label = "pmk8850_offset_ref";
					};

					pmk8850_vref_1p25 {
						reg = <0x01>;
						label = "pmk8850_vref_1p25";
					};

					pmk8850_die_temp {
						reg = <0x03>;
						label = "pmk8850_die_temp";
					};

					xoagg_therm: pmk8850_xoagg_therm {
						reg = <0x4b>;
						label = "pmk8850_xoagg_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						phandle = <0x6c>;
					};

					pmh0101_offset_ref {
						reg = <0x100>;
						label = "pmh0101_offset_ref";
					};

					pmh0101_vref_1p25 {
						reg = <0x101>;
						label = "pmh0101_vref_1p25";
					};

					pmh0101_die_temp {
						reg = <0x103>;
						label = "pmh0101_die_temp";
					};

					pmh0101_vph_pwr {
						reg = <0x18e>;
						label = "pmh0101_vph_pwr";
					};

					qtm_therm: pmh0101_qtm_therm {
						reg = <0x14b>;
						label = "pmh0101_qtm_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						phandle = <0x6d>;
					};

					pmh0101_pa_therm2 {
						reg = <0x149>;
						label = "pmh0101_pa_therm_2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0110_d_die_temp {
						reg = <0x303>;
						label = "pmh0110_d_die_temp";
					};

					pmh0110_d_vph_pwr {
						reg = <0x38e>;
						label = "pmh0110_d_vph_pwr";
					};

					pmh0110_f_die_temp {
						reg = <0x503>;
						label = "pmh0110_f_die_temp";
					};

					pmh0110_f_vph_pwr {
						reg = <0x58e>;
						label = "pmh0110_f_vph_pwr";
					};

					pmh0110_g_die_temp {
						reg = <0x603>;
						label = "pmh0110_g_die_temp";
					};

					pmh0110_g_vph_pwr {
						reg = <0x68e>;
						label = "pmh0110_g_vph_pwr";
					};

					pmh0110_i_die_temp {
						reg = <0x803>;
						label = "pmh0110_i_die_temp";
					};

					pmh0110_i_vph_pwr {
						reg = <0x88e>;
						label = "pmh0110_i_vph_pwr";
					};

					pmih010x_offset_ref {
						reg = <0x2700>;
						label = "pmih010x_offset_ref";
					};

					pmih010x_vref_1p25 {
						reg = <0x2701>;
						label = "pmih010x_vref_1p25";
					};

					pmih010x_die_temp {
						reg = <0x2703>;
						label = "pmih010x_die_temp";
					};

					pmih010x_vph_pwr {
						reg = <0x278e>;
						label = "pmih010x_vph_pwr";
					};

					pmih010x_vbat_sns_qbg {
						reg = <0x278f>;
						label = "pmih010x_vbat_sns_qbg";
					};

					pmih010x_iin {
						reg = <0x2717>;
						label = "pmih010x_iin";
					};

					pmih010x_ichg_fb {
						reg = <0x27a1>;
						label = "pmih010x_ichg_fb";
					};

					pmih010x_chg_temp {
						reg = <0x2710>;
						label = "pmih010x_chg_temp";
					};

					pmih010x_lite_die_temp {
						reg = <0x2718>;
						label = "pmih010x_lite_die_temp";
					};

					display_therm: pmih010x_display_therm {
						reg = <0x275e>;
						label = "pmih010x_display_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						phandle = <0x6e>;
					};

					charger_therm: pmih010x_charger_therm {
						reg = <0x274d>;
						label = "pmih010x_charger_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						phandle = <0x6f>;
					};

					wireless_therm: pmh0101_wireless_therm {
						reg = <0x14c>;
						label = "pmh0101_wireless_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						phandle = <0x70>;
					};

					pmh0101_cpu_therm {
						reg = <0x14d>;
						label = "pmh0101_cpu_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmk8850_xo_therm {
						reg = <0x44>;
						label = "pmk8850_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_wifi_therm {
						reg = <0x146>;
						label = "pmh0101_wifi_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_pa_therm1 {
						reg = <0x147>;
						label = "pmh0101_pa_therm_1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_quiet_therm {
						reg = <0x144>;
						label = "pmh0101_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_flash_therm {
						reg = <0x145>;
						label = "pmh0101_flash_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_batt_therm {
						reg = <0x2744>;
						label = "pmih010x_batt_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_conn_therm {
						reg = <0x2747>;
						label = "pmih010x_conn_therm_1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};
				};

				pmk8850_qpt: qcom,power-telemetry-device {
					compatible = "qcom,power-telemetry";
					status = "okay";
					interrupts = <0x00 0xa2 0x01 0x01 0x00 0xa1 0x01 0x01>;
					nvmem = <&pmk8850_sdam_49>, <&pmk8850_sdam_50>, <&pmk8850_sdam_51>;
					nvmem-names = "qpt-config-sdam", "qpt-frac-sdam", "qpt-data-sdam";
					#powerzone-cells = <0x01>;
					power-domains = <&CLUSTER_PD2>;
					phandle = <0x1a>;
				};

				pmk8850_qvadj: qcom,voltage-adj-device {
					compatible = "qcom,vadj";
					phandle = <0x71>;
				};

				btl {
					compatible = "qcom,btl";
					nvmem = <&pmk8850_sdam_72>;
					nvmem-names = "btl-sdam";
				};

				qcom,power-telemetry-data-share-device {
					compatible = "qcom,power-telemetry-data-share";
				};
			};

			pmh0101@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0101";
				};

				pmh0101_tz: pmh0101-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8850_vadc>, <0x103>;
					io-channel-names = "thermal";
					phandle = <0x24>;
				};

				pmh0101_gpios: pinctrl@8800 {
					compatible = "qcom,pmh0101-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <&wireless_therm_default>, <&cpu_therm_default>;
					pinctrl-names = "default";
					phandle = <0x4d>;

					qtm_therm_default: qtm-therm-default-state {
						pins = "gpio2";
						function = "normal";
						bias-high-impedance;
						phandle = <0x04>;
					};

					pa_therm2_default: pa-therm2-default-state {
						pins = "gpio3";
						function = "normal";
						bias-high-impedance;
						phandle = <0x03>;
					};

					cam_sensor_1p8_rst0_active: cam-sensor-1p8-rst0-active-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-high;
						power-source = <0x00>;
						phandle = <0x72>;
					};

					cam_sensor_1p8_rst0_suspend: cam-sensor-1p8-rst0-suspend-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-low;
						phandle = <0x73>;
					};

					pmh0101_bidir_lvl_shifter1_active: pmh0101-bidir-lvl-shifter1-state {
						pins = "gpio11", "gpio12";
						function = "normal";
						bias-high-impedance;
						phandle = <0x74>;
					};

					pmh0101_bidir_lvl_shifter2_active: pmh0101-bidir-lvl-shifter2-state {
						pins = "gpio13", "gpio14";
						function = "normal";
						bias-high-impedance;
						phandle = <0x75>;
					};

					pmh0101_bidir_lvl_shifter3_active: pmh0101-bidir-lvl-shifter3-state {
						pins = "gpio15", "gpio16";
						function = "normal";
						bias-high-impedance;
						phandle = <0x76>;
					};

					pmh0101_bidir_lvl_shifter4_active: pmh0101-bidir-lvl-shifter4-state {
						pins = "gpio17", "gpio18";
						function = "normal";
						bias-high-impedance;
						phandle = <0x77>;
					};

					wireless_therm_default: wireless_therm-default-state {
						pins = "gpio9";
						function = "normal";
						bias-high-impedance;
						phandle = <0x0a>;
					};

					cpu_therm_default: cpu_therm-default-state {
						pins = "gpio12";
						function = "normal";
						bias-high-impedance;
						phandle = <0x0b>;
					};

					slave_batt_det {

						slave_batt_det_default: slave_batt_det_default {
							pins = "gpio1";
							function = "gpio";
							input-enable;
							bias-pull-up;
							phandle = <0x4c>;
						};
					};
				};

				led_controller: led-controller {
					compatible = "qcom,pmh0101-pwm", "qcom,pm8350c-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					nvmem = <&pmk8850_sdam_21>, <&pmk8850_sdam_22>;
					nvmem-names = "lpg_chan_sdam", "lut_sdam";
					phandle = <0x78>;

					led@1 {
						reg = <0x01>;
						color = <0x01>;
						label = "red";
					};

					led@2 {
						reg = <0x02>;
						color = <0x02>;
						label = "green";
					};

					led@3 {
						reg = <0x03>;
						color = <0x03>;
						label = "blue";
					};
				};

				pmh0101_bcl: bcl@4700 {
					compatible = "qcom,pmh0101-bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x01 0x47 0x00 0x00 0x01 0x47 0x01 0x00 0x01 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x1f>;
				};

				pmh0101_flash: led-controller@ee00 {
					compatible = "qcom,pmh0101-flash-led", "qcom,spmi-flash-led";
					reg = <0xee00>;
					phandle = <0x79>;

					pmh0101_flash_led0: led-0 {
						function = "flash";
						function-enumerator = <0x00>;
						color = <0x06>;
						led-sources = <0x01>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0xf4240>;
						flash-max-timeout-us = <0x493e0>;
						phandle = <0x7a>;
					};

					pmh0101_flash_led1: led-1 {
						function = "flash";
						function-enumerator = <0x01>;
						color = <0x00>;
						led-sources = <0x02 0x03>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						phandle = <0x7b>;
					};

					pmh0101_flash_led2: led-2 {
						function = "flash";
						function-enumerator = <0x02>;
						color = <0x04>;
						led-sources = <0x01 0x02 0x03 0x04>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						phandle = <0x7c>;
					};
				};
			};

			pmh0110_d: pmh0110@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x7d>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0110_d";
				};

				pmh0110_d_tz: pmh0110-d-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x03 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8850_vadc>, <0x303>;
					io-channel-names = "thermal";
					phandle = <0x25>;
				};

				pmh0110_d_gpios: pinctrl@8800 {
					compatible = "qcom,pmh0110-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x7e>;

					ts_rst_1p2_active: ts-rst-1p2-active-state {
						pins = "gpio5";
						function = "paired";
						input-enable;
						output-disable;
						power-source = <0x02>;
						phandle = <0x7f>;
					};

					ts_rst_1p8_active: ts-rst-1p8-active-state {
						pins = "gpio6";
						function = "paired";
						input-disable;
						output-enable;
						power-source = <0x01>;
						phandle = <0x80>;
					};

					ts_int_1p2_active: ts-int-1p2-active-state {
						pins = "gpio11";
						function = "paired";
						input-disable;
						output-enable;
						power-source = <0x01>;
						phandle = <0x81>;
					};

					ts_int_1p8_active: ts-int-1p8-active-state {
						pins = "gpio12";
						function = "paired";
						input-enable;
						output-disable;
						power-source = <0x00>;
						phandle = <0x82>;
					};

					ts0_rst_1p2_default: ts0-rst-1p2-default-state {
						pins = "gpio5";
						function = "paired";
						input-enable;
						output-disable;
						power-source = <0x02>;
						bias-disable;
						phandle = <0x83>;
					};

					ts0_rst_1p8_default: ts0-rst-1p8-default-state {
						pins = "gpio6";
						function = "paired";
						output-enable;
						input-disable;
						power-source = <0x01>;
						bias-disable;
						phandle = <0x84>;
					};

					ts0_int_1p2_default: ts0-int-1p2-default-state {
						pins = "gpio11";
						function = "paired";
						input-disable;
						output-enable;
						power-source = <0x01>;
						phandle = <0x85>;
					};

					ts0_int_1p8_default: ts0-int-1p8-default-state {
						pins = "gpio12";
						function = "paired";
						output-disable;
						input-enable;
						power-source = <0x00>;
						phandle = <0x86>;
					};

					sde_mdp_vsync_p_1p2_active: sde-mdp-vsync-p-1p2-active-state {
						phandle = <0x205>;
						power-source = <0x02>;
						output-enable;
						input-disable;
						function = "paired";
						pins = "gpio9";
					};

					sde_mdp_vsync_p_1p8_active: sde-mdp-vsync-p-1p8-active-state {
						phandle = <0x206>;
						power-source = <0x01>;
						output-disable;
						input-enable;
						function = "paired";
						pins = "gpio10";
					};
				};
			};

			pmh0110_f: pmh0110@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x87>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0110_f";
				};

				pmh0110_f_tz: pmh0110-f-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x05 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8850_vadc>, <0x503>;
					io-channel-names = "thermal";
					phandle = <0x27>;
				};

				pmh0110_f_gpios: pinctrl@8800 {
					compatible = "qcom,pmh0110-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x88>;

					sde_disp0_rst_1p2_active: sde-disp0-rst-1p2-active-state {
						phandle = <0x207>;
						power-source = <0x02>;
						output-disable;
						input-enable;
						function = "paired";
						pins = "gpio9";
					};

					sde_disp0_rst_1p8_active: sde-disp0-rst-1p8-active-state {
						phandle = <0x208>;
						power-source = <0x01>;
						output-enable;
						input-disable;
						function = "paired";
						pins = "gpio10";
					};
				};
			};

			pmh0110_g: pmh0110@6 {
				compatible = "qcom,spmi-pmic";
				reg = <0x06 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x89>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0110_g";
				};

				pmh0110_g_tz: pmh0110-g-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x06 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8850_vadc>, <0x603>;
					io-channel-names = "thermal";
					phandle = <0x29>;
				};

				pmh0110_g_gpios: pinctrl@8800 {
					compatible = "qcom,pmh0110-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x8a>;
				};
			};

			pmh0110_i: pmh0110@8 {
				compatible = "qcom,spmi-pmic";
				reg = <0x08 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x8b>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0110_i";
				};

				pmh0110_i_tz: pmh0110-i-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x08 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8850_vadc>, <0x803>;
					io-channel-names = "thermal";
					phandle = <0x2b>;
				};

				pmh0110_i_gpios: pinctrl@8800 {
					compatible = "qcom,pmh0110-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x8c>;

					cam_sensor_1p8_rst1_active: cam-sensor-1p8-rst1-active-state {
						pins = "gpio12";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-high;
						power-source = <0x00>;
						phandle = <0x8d>;
					};

					cam_sensor_1p8_rst1_suspend: cam-sensor-1p8-rst1-suspend-state {
						pins = "gpio12";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-low;
						phandle = <0x8e>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <&spmi1_bus>;

		__overlay__ {

			qcom,pmd802x@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmd802x";
				};

				pmd802x_tz: pmd802x-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x04 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x2d>;
				};

				pmd802x_gpios: pinctrl@8800 {
					compatible = "qcom,pmd802x-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x8f>;

					sde_disp0_vdd_active: sde_disp0_vdd_active {
						phandle = <0x217>;
						qcom,drive-strength = <0x02>;
						power-source = <0x02>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio2";
					};
				};

				pmd802x_amoled_ecm: amoled-ecm@f900 {
					compatible = "qcom,amoled-ecm";
					reg = <0xf900>;
					interrupt-names = "ecm-sdam0", "ecm-sdam1", "ecm-sdam2";
					nvmem-names = "amoled-ecm-sdam0", "amoled-ecm-sdam1", "amoled-ecm-sdam2";
					nvmem = <&pmk8850_sdam_59>, <&pmk8850_sdam_60>, <&pmk8850_sdam_61>;
					interrupt-parent = <&spmi0_bus>;
					interrupts = <0x00 0xaa 0x01 0x01 0x00 0xab 0x01 0x01 0x00 0xac 0x01 0x01>;
					phandle = <0x90>;
				};

				pmd802x_amoled: qcom-amoled {
					compatible = "qcom,amoled-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					nvmem-cells = <&ibb_spur_sqm_timer>;
					nvmem-cell-names = "ibb_spur_sqm_timer";
					status = "disabled";
					phandle = <0x91>;

					ibb_vreg: ibb@f800 {
						reg = <0xf800>;
						reg-names = "ibb_base";
						regulator-name = "ibb";
						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = <0x895440>;
						regulator-allow-set-load;
						qcom,swire-control;
						phandle = <0x92>;
					};

					ab_vreg: elvdd@f900 {
						reg = <0xf900>;
						reg-names = "ab_base";
						regulator-name = "ab";
						regulator-min-microvolt = <0x2625a0>;
						regulator-max-microvolt = <0x53ec60>;
						qcom,swire-control;
						phandle = <0x93>;
					};

					oledb_vreg: oledb@fa00 {
						reg = <0xfa00>;
						reg-names = "oledb_base";
						regulator-name = "oledb";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x7a1200>;
						qcom,swire-control;
						phandle = <0x94>;
					};
				};
			};

			qcom,pmih010x@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmih010x";
				};

				pmih010x_tz: pmih010x-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x07 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8850_vadc>, <0x2703>;
					io-channel-names = "thermal";
					phandle = <0x23>;
				};

				pmih010x_lite_tz: pmih010x-temp-alarm-lite@c00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xc00>;
					interrupts = <0x07 0x0c 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8850_vadc>, <0x2718>;
					io-channel-names = "thermal";
					phandle = <0x2e>;
				};

				pmih010x_gpios: pinctrl@8800 {
					compatible = "qcom,pmih010x-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <&display_therm_default>, <&charger_therm_default>;
					pinctrl-names = "default";
					phandle = <0x4b>;

					display_therm_default: display_therm-default-state {
						pins = "gpio18";
						function = "normal";
						bias-high-impedance;
						phandle = <0x12>;
					};

					charger_therm_default: charger_therm-default-state {
						pins = "gpio12";
						function = "normal";
						bias-high-impedance;
						phandle = <0x13>;
					};

					anti_burn_mos_ctrl {

						anti_burn_mos_ctrl_default: anti_burn_mos_ctrl_default {
							pins = "gpio7";
							function = "normal";
							output-enable;
							power-source = <0x00>;
							phandle = <0x4a>;
						};
					};
				};

				pmih010x_eusb2_repeater: eusb2-repeater@fd00 {
					compatible = "qcom,pmic-eusb2-repeater";
					reg = <0xfd00>;
					vdd18-supply = <&pmh0101_l15>;
					vdd3-supply = <&pmh0101_l5>;
					qcom,param-override-seq-global = <0x00 0x50 0x0e 0x51 0x04 0x52 0x07 0x53 0x03 0x54 0x01 0x55 0x03 0x56 0x05 0x57 0x02 0x58 0x01 0x59 0x03 0x5a 0x02 0x5b>;
					qcom,host-param-override-seq = <0x00 0x50 0x0e 0x51 0x04 0x52 0x07 0x53 0x03 0x54 0x01 0x55 0x03 0x56 0x04 0x57 0x02 0x58 0x01 0x59 0x03 0x5a 0x02 0x5b>;
					qcom,param-override-seq = <0x00 0x50 0x0e 0x51 0x04 0x52 0x07 0x53 0x03 0x54 0x01 0x55 0x03 0x56 0x05 0x57 0x02 0x58 0x01 0x59 0x03 0x5a 0x02 0x5b>;
					phandle = <0x33>;
				};

				pmih010x_haptics: qcom,hv-haptics@f000 {
					qcom,lra-f0-cal-count = <0x23a>;
					qcom,lra-f0-default = <0xaa>;
					qcom,lra-f0-max = <0xb4>;
					qcom,lra-f0-min = <0xa0>;
					qcom,f0-vmax-mv = <0x4e2>;
					qcom,custom_vmax_mv = <0x1f40>;
					qcom,swr-brake-pattern = [00 28 1a 10 08 06];
					qcom,swr-brake-vmax-mv = <0x21fc>;
					qcom,swr-brake-mode = <0x01>;
					qcom,over-brake-half-cycles = [06];
					qcom,over-drive-half-cycles = [02];
					qcom,over-drive-mv = <0x21fc>;
					qcom,freq-detect-in-play;
					status = "ok";
					compatible = "qcom,hv-haptics";
					reg = <0xf000 0xf100 0xf200>;
					interrupts = <0x07 0xf0 0x01 0x01>;
					interrupt-names = "fifo-empty";
					qcom,vmax-mv = <0x4e2>;
					qcom,lra-period-us = <0x1652>;
					qcom,brake-mode = <0x01>;
					qcom,brake-pattern = [20 20 20 20 20 20];
					qcom,drv-sig-shape = <0x01>;
					qcom,brake-sig-shape = <0x01>;
					qcom,rt-imp-detect;
					nvmem-names = "hap_cfg_sdam";
					nvmem = <&pmk8850_sdam_46>;
					phandle = <0x95>;

					hap_swr_slave_reg: qcom,hap-swr-slave-reg {
						regulator-name = "hap-swr-slave-reg";
						phandle = <0x96>;
					};

					effect_0 {
						qcom,effect-id = <0x00>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = <0x7f7f7f7f>;
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_1 {
						qcom,effect-id = <0x01>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_2 {
						qcom,effect-id = <0x02>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_3 {
						qcom,effect-id = <0x03>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_4 {
						qcom,effect-id = <0x04>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_5 {
						qcom,effect-id = <0x05>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_0 {
						qcom,primitive-id = <0x00>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = <0x00>;
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_1 {
						qcom,primitive-id = <0x01>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_2 {
						qcom,primitive-id = <0x02>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_3 {
						qcom,primitive-id = <0x03>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_4 {
						qcom,primitive-id = <0x04>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_5 {
						qcom,primitive-id = <0x05>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_6 {
						qcom,primitive-id = <0x06>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_7 {
						qcom,primitive-id = <0x07>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_8 {
						qcom,primitive-id = <0x08>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};
				};

				pmih010x_bcl: bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x07 0x47 0x00 0x00 0x07 0x47 0x01 0x00 0x07 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x1b>;
				};

				pmih010x_bcl2: bcl@4900 {
					compatible = "qcom,bcl-v5";
					reg = <0x4900 0x100>;
					interrupts = <0x07 0x49 0x00 0x00 0x07 0x49 0x01 0x00 0x07 0x49 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					status = "disabled";
					phandle = <0x97>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x98>;
				};
			};

			pmh0104@9 {
				compatible = "qcom,spmi-pmic";
				reg = <0x09 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0104";
				};

				pmh0104_tz: pmh0104-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x09 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x2f>;
				};

				pmh0104_gpios: pinctrl@8800 {
					compatible = "qcom,pmh0104-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x99>;

					bt_en: bt_en {
						phandle = <0x361>;
						power-source = <0x01>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio5";
					};

					bt_fmd_clk_en: bt_fmd_clk_en {
						phandle = <0x363>;
						power-source = <0x01>;
						bias-disable;
						output-disable;
						input-enable;
						function = "normal";
						pins = "gpio6";
					};
				};
			};

			qcom,pmr735d@a {
				compatible = "qcom,spmi-pmic";
				reg = <0x0a 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmr735d_ecid: pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmr735d";
					phandle = <0x9a>;
				};

				pmr735d_tz: pmr735d-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x0a 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x30>;
				};

				pmr735d_gpios: pinctrl@8800 {
					compatible = "qcom,pmr735d-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x9b>;
				};
			};

			pm8010_m: qcom,pm8010@c {
				compatible = "qcom,spmi-pmic";
				reg = <0x0c 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x9c>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pm8010_m";
				};

				pm8010m_tz: pm8010m-temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x0c 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x31>;
				};
			};

			pm8010_n: qcom,pm8010@d {
				compatible = "qcom,spmi-pmic";
				reg = <0x0d 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x9d>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pm8010_n";
				};

				pm8010n_tz: pm8010n-temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x0d 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x32>;
				};
			};
		};
	};

	fragment@2 {
		target = <&soc>;

		__overlay__ {

			reboot_reason {
				compatible = "qcom,reboot-reason";
				nvmem-cells = <&restart_reason>;
				nvmem-cell-names = "restart_reason";
			};

			pmic-pon-log {
				compatible = "qcom,pmic-pon-log";
				nvmem = <&pmk8850_sdam_5>, <&pmk8850_sdam_6>;
				nvmem-names = "pon_log0", "pon_log1";
				depends-on-supply = <&wdog>;
				qcom,pmic-fault-panic;
			};

			regulator_ocp_notifier: regulator-ocp-notifer {
				compatible = "qcom,regulator-ocp-notifier";
				interrupt-parent = <&spmi0_bus>;
				interrupts = <0x00 0x71 0x01 0x01 0x00 0x85 0x01 0x01>;
				nvmem-cells = <&ocp_log>, <&alarm_log>;
