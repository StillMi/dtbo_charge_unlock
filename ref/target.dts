	fragment@31 {
		target = <&soc>;

		__overlay__ {

			mi_t1_chip {
				compatible = "mdm,mi_t1_chip";
				gpio-count = <0x06>;
				first-gpio = <0x02>;
				#gpio-cells = <0x02>;
				mi-t1-gpio-1 = <&tlmm>, <0x02 0x00>;
				mi-t1-gpio-2 = <&tlmm>, <0x49 0x00>;
				mi-t1-gpio-3 = <&tlmm>, <0x4c 0x00>;
				mi-t1-gpio-4 = <&tlmm>, <0x6b 0x00>;
				mi-t1-gpio-5 = <&tlmm>, <0x76 0x00>;
				mi-t1-gpio-6 = <&tlmm>, <0x8e 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&t1_gpio_ctl>;
			};
		};
	};

	fragment@32 {
		target = <&tlmm>;

		__overlay__ {

			t1_gpio_ctl: t1_gpio_ctl {
				phandle = <0x40>;

				mux {
					pins = "gpio2", "gpio73", "gpio76", "gpio107", "gpio118", "gpio142";
					function = "gpio";
				};

				config {
					pins = "gpio2", "gpio73", "gpio76", "gpio107", "gpio118", "gpio142";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};
		};
	};

